# Unreal Engine Folders to Ignore
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/
.vscode/
.vs/
FileOpenOrder/

# User-specific files
*.sln
*.suo
*.user
*.userosscache
*.sln.docuser.tar.gz

# Specialized ignore for Marketplace/Third-Party Content
# This keeps your custom folders but blocks common marketplace paths
# Adjust "Marketplace" if your folder name is different
Content/Marketplace/

# Compiled C++ files
*.pdb
*.obj
*.exe
*.dll

# OS generated files
.DS_Store
Thumbs.db

# Ignore Epic's heavy starter assets
Content/StarterContent/

# Ignore IDE-specific plugins
Plugins/VisualStudioTools/
Plugins/

# Ignore External Actor and Object data
__ExternalActors__/
__ExternalObjects__/
